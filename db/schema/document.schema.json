{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:satbayev:document-schema:1.0",
  "title": "Satbayev normalized document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "document_id", "source_version_sha256", "title", "source", "artifacts", "extraction", "blocks", "assets", "references"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "document_id": {"type": "string", "minLength": 1},
    "source_version_sha256": {"$ref": "#/$defs/hash"},
    "title": {"type": "string"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "name", "format", "size", "sha256", "urls", "sections", "manifest_path"],
      "properties": {
        "path": {"type": "string"}, "name": {"type": "string"}, "format": {"type": "string"},
        "size": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/hash"},
        "urls": {"type": "array", "items": {"type": "string"}},
        "sections": {"type": "array", "items": {"type": "string"}},
        "manifest_path": {"type": "string"}
      }
    },
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "blocks": {"type": "array", "items": {"$ref": "#/$defs/block"}},
    "references": {
      "type": "array", "items": {
        "type": "object", "required": ["kind", "value", "block_id", "evidence", "source_refs"],
        "properties": {
          "kind": {"enum": ["url", "document_code"]}, "value": {"type": "string"},
          "block_id": {"type": "string"}, "evidence": {"type": "string"},
          "source_refs": {"type": "array", "items": {"$ref": "#/$defs/locator"}}
        }, "additionalProperties": false
      }
    },
    "extraction": {
      "type": "object", "required": ["status", "fingerprint", "converted_at", "tools", "settings", "coverage", "warnings", "errors"],
      "properties": {
        "status": {"enum": ["complete", "partial", "failed"]}, "fingerprint": {"$ref": "#/$defs/hash"},
        "converted_at": {"type": "string", "pattern": "Z$"}, "tools": {"type": "object"}, "settings": {"type": "object"},
        "coverage": {"type": "object"}, "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}},
        "errors": {"type": "array", "items": {"type": "string"}}
      }, "additionalProperties": false
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "warning": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}}, "additionalProperties": false},
    "quality": {
      "type": "object", "required": ["method", "needs_review", "confidence", "verification", "warnings"],
      "properties": {
        "method": {"type": "string"}, "needs_review": {"type": "boolean"}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
        "verification": {"enum": ["machine_extracted", "human_verified", "unprocessed"]},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/warning"}}
      }, "additionalProperties": false
    },
    "locator": {
      "type": "object", "required": ["artifact_id", "source_sha256", "kind"],
      "properties": {
        "artifact_id": {"type": "string"}, "source_sha256": {"$ref": "#/$defs/hash"},
        "kind": {"enum": ["pdf_region", "ooxml_node", "sheet_range", "drawing", "artifact"]},
        "page": {"type": "integer", "minimum": 1}, "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "page_size": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "part": {"type": "string"}, "xpath": {"type": "string"}, "sheet": {"type": "string"},
        "range": {"type": "string"}, "object_id": {"type": ["string", "null"]}, "anchor": {"type": "object"},
        "char_start": {"type": "integer", "minimum": 0}, "char_end": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "pdf_region"}}}, "then": {"required": ["page", "bbox", "page_size"]}},
        {"if": {"properties": {"kind": {"const": "ooxml_node"}}}, "then": {"required": ["part", "xpath"]}},
        {"if": {"properties": {"kind": {"const": "sheet_range"}}}, "then": {"required": ["sheet", "range"]}},
        {"if": {"properties": {"kind": {"const": "drawing"}}}, "then": {"required": ["part", "xpath", "anchor"]}}
      ], "additionalProperties": false
    },
    "artifact": {
      "type": "object", "required": ["id", "path", "format", "sha256", "size", "derived_from", "kind"],
      "properties": {
        "id": {"type": "string"}, "path": {"type": "string"}, "format": {"type": "string"},
        "sha256": {"$ref": "#/$defs/hash"}, "size": {"type": "integer", "minimum": 0},
        "derived_from": {"type": "string"}, "kind": {"type": "string"}
      }, "additionalProperties": false
    },
    "asset": {
      "type": "object", "required": ["id", "artifact_id", "role", "source_refs"],
      "properties": {
        "id": {"type": "string"}, "artifact_id": {"type": "string"}, "role": {"type": "string"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}}
      }, "additionalProperties": false
    },
    "cell": {
      "type": "object", "required": ["id", "row", "column", "rowspan", "colspan", "type", "value", "text", "formula", "cached_value", "source_refs"],
      "properties": {
        "id": {"type": "string"}, "row": {"type": "integer", "minimum": 0}, "column": {"type": "integer", "minimum": 0},
        "rowspan": {"type": "integer", "minimum": 1}, "colspan": {"type": "integer", "minimum": 1}, "type": {"type": "string"},
        "value": {}, "text": {"type": "string"}, "formula": {"type": ["string", "null"]}, "cached_value": {},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}}
      }, "additionalProperties": false
    },
    "block": {
      "type": "object", "required": ["id", "order", "parent_id", "kind", "role", "text", "payload", "source_refs", "quality"],
      "properties": {
        "id": {"type": "string"}, "order": {"type": "integer", "minimum": 0}, "parent_id": {"type": ["string", "null"]},
        "kind": {"enum": ["heading", "paragraph", "list_item", "table", "image", "diagram", "note", "attachment", "unparsed"]},
        "role": {"type": "string"}, "text": {"type": "string"}, "payload": {"type": "object"},
        "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/locator"}}, "quality": {"$ref": "#/$defs/quality"}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "table"}}}, "then": {"properties": {"payload": {
        "type": "object", "required": ["rows", "columns", "cells", "merges"],
        "properties": {"rows": {"type": "integer", "minimum": 0}, "columns": {"type": "integer", "minimum": 0}, "cells": {"type": "array", "items": {"$ref": "#/$defs/cell"}}, "merges": {"type": "array"}}
      }}}}], "additionalProperties": false
    }
  }
}
