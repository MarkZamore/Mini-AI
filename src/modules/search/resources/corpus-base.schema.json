{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mini-ai:corpus-identity:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["base_id", "content_version"],
  "properties": {
    "base_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$"},
    "content_version": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
