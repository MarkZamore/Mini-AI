{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterpriseai:inference:worker-manifest:v1",
  "title": "EnterpriseAI offline Windows CPU/CUDA worker manifest v1/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "protocol",
    "executable",
    "engine",
    "revision",
    "architecture",
    "supportedIsa",
    "weights",
    "files",
    "precision",
    "contextTokens",
    "threads",
    "minFreeMemoryBytes",
    "maxProcessMemoryBytes"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        1,
        2
      ]
    },
    "protocol": {
      "const": "enterpriseai.inference.v1"
    },
    "executable": {
      "const": "inference-worker.exe"
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "architecture": {
      "const": "windows-x64"
    },
    "supportedIsa": {
      "description": "Required CPU instruction sets. Every requirement must be recognized and positively verified by the host; this is not a list of optional backends.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9_.-]*$"
      }
    },
    "weights": {
      "$ref": "#/$defs/file"
    },
    "files": {
      "description": "Complete hashed file inventory. Version 1 permits one standalone EXE and no DLL. Version 2 permits one EXE and only explicitly inventoried runtime/*.dll dependencies. Evidence assets also belong to files.",
      "type": "array",
      "minItems": 2,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "precision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "contextTokens": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "threads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "minFreeMemoryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxProcessMemoryBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "device",
        "gpuMemoryBudgetBytes",
        "reserveFreeGpuMemoryBytes"
      ],
      "properties": {
        "kind": {
          "enum": [
            "cpu",
            "cuda"
          ]
        },
        "device": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "gpuMemoryBudgetBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reserveFreeGpuMemoryBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "cpu"
              }
            }
          },
          "then": {
            "properties": {
              "device": {
                "const": 0
              },
              "gpuMemoryBudgetBytes": {
                "const": 0
              },
              "reserveFreeGpuMemoryBytes": {
                "const": 0
              }
            }
          },
          "else": {
            "properties": {
              "gpuMemoryBudgetBytes": {
                "minimum": 1
              },
              "reserveFreeGpuMemoryBytes": {
                "minimum": 536870912
              }
            }
          }
        }
      ]
    },
    "dependencies": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "embedder",
        "tokenizerDirectory",
        "index"
      ],
      "properties": {
        "embedder": {
          "$ref": "#/$defs/file"
        },
        "reranker": {
          "$ref": "#/$defs/file"
        },
        "tokenizerDirectory": {
          "$ref": "#/$defs/relativePath"
        },
        "index": {
          "$ref": "#/$defs/file"
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "description": "Forward-slash relative path under model, with no traversal, empty segment, drive, ADS, trailing dot/space, Windows wildcard, control character or backslash. Canonical containment and Windows reserved names are checked by the host.",
      "type": "string",
      "minLength": 1,
      "maxLength": 32760,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$)(?!.*[. ](?:/|$))[^\\\\:\\u0000-\\u001f<>\"|?*]+$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dependency": {
      "allOf": [
        {
          "$ref": "#/$defs/file"
        },
        {
          "properties": {
            "path": {
              "pattern": "^runtime/[a-z0-9_.-]+\\.dll$"
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": 1
          }
        }
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "backend"
              ]
            },
            {
              "required": [
                "dependencies"
              ]
            },
            {
              "required": [
                "evidence"
              ]
            }
          ]
        }
      },
      "else": {
        "required": [
          "backend",
          "dependencies"
        ]
      }
    }
  ]
}
