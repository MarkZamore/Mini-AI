{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:enterpriseai:inference:worker-protocol:v1",
  "title": "One EnterpriseAI inference protocol JSONL frame v1",
  "oneOf": [
    { "$ref": "#/$defs/hello" }, { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/generate" }, { "$ref": "#/$defs/token" },
    { "$ref": "#/$defs/done" }, { "$ref": "#/$defs/cancel" },
    { "$ref": "#/$defs/cancelled" }, { "$ref": "#/$defs/error" }
  ],
  "$defs": {
    "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": { "enum": ["system", "user", "assistant"] },
        "content": { "type": "string" }
      }
    },
    "hello": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol"],
      "properties": { "type": { "const": "hello" }, "protocol": { "const": "enterpriseai.inference.v1" } }
    },
    "ready": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "protocol"],
      "properties": { "type": { "const": "ready" }, "protocol": { "const": "enterpriseai.inference.v1" } }
    },
    "generate": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "requestId", "messages", "maxTokens"],
      "properties": {
        "type": { "const": "generate" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "messages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/message" } },
        "maxTokens": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
      }
    },
    "token": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "requestId", "text"],
      "properties": {
        "type": { "const": "token" },
        "requestId": { "$ref": "#/$defs/requestId" }, "text": { "type": "string" }
      }
    },
    "done": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "done" }, "requestId": { "$ref": "#/$defs/requestId" } }
    },
    "cancel": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "cancel" }, "requestId": { "$ref": "#/$defs/requestId" } }
    },
    "cancelled": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "requestId"],
      "properties": { "type": { "const": "cancelled" }, "requestId": { "$ref": "#/$defs/requestId" } }
    },
    "error": {
      "description": "requestId is absent for handshake/process errors; required semantically for an error terminating an active generation.",
      "type": "object", "additionalProperties": false,
      "required": ["type", "code", "message"],
      "properties": {
        "type": { "const": "error" }, "requestId": { "$ref": "#/$defs/requestId" },
        "code": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Z][A-Z0-9_]*$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 65536 }
      }
    }
  }
}
